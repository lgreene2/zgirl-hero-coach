# Z-Girl v2.2.2 protected native-language reviewer workspace.
# Store SHA-256 reviewer-code hashes—not plaintext reviewer codes—in the map.
# All four values are server-only. Set them as sensitive Vercel environment
# variables and never commit real credentials, private asset locations, or
# plaintext reviewer codes.
ZGIRL_REVIEW_ACCESS_HASHES_JSON=
ZGIRL_REVIEW_SESSION_SECRET=

# Base URL must end at the private project's gateway route, for example:
# https://<private-gateway-host>/api/review-assets
ZGIRL_REVIEW_ASSET_BASE_URL=

# Must exactly match ZGIRL_ASSET_GATEWAY_BEARER_TOKEN in the private project.
ZGIRL_REVIEW_ASSET_BEARER_TOKEN=
